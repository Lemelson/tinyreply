# Copy to $STATE_DIR/.env (mode 600). The bot re-reads this file every cycle; it never reads secrets
# from the process environment. Never commit the real file: .gitignore and the pre-commit hook block it.

# Instagram user access token (Instagram API with Instagram Login). After the first cycle the bot keeps
# a refreshed copy in core.db; a new value here is picked up automatically.
IG_ACCESS_TOKEN=

# Optional but strongly recommended: where alerts go.
TG_BOT_TOKEN=
TG_CHAT_ID=
