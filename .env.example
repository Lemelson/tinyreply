# Copy to $STATE_DIR/.env (mode 600). The bot re-reads this file every cycle; it never reads secrets
# from the process environment. Never commit the real file: .gitignore and the pre-commit hook block it.

# Instagram user access token (Instagram API with Instagram Login). After the first cycle the bot keeps
# a refreshed copy in core.db; a new value here is picked up automatically.
IG_ACCESS_TOKEN=

# Optional but strongly recommended: where alerts go.
TG_BOT_TOKEN=
TG_CHAT_ID=

# Only for the optional web process (web.py: button, follow check, click tracking, panel). See README.
# App secret of your Meta app (App settings > Basic): checks the signature of every webhook delivery.
IG_APP_SECRET=
# Any long random string; paste the same value as the "Verify token" of the webhook in the Meta app dashboard.
WEBHOOK_VERIFY_TOKEN=
# Login for the panel at https://your-domain/panel/. Either one empty: the panel answers 403 to everyone.
PANEL_USER=
PANEL_PASSWORD=
